rule RERUN_CMAKE
  command = /usr/local/bin/cmake --regenerate-during-build -S/home/flits/Documents/school/semesterproject/startweekavans25/Project -B/home/flits/Documents/school/semesterproject/startweekavans25/Project/cmake-build-debug-zephyr
  description = Re-running CMake...
  generator = 1


#############################################
